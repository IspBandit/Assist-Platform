# =====================================================================
# Assist Platform Enterprise environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit a real .env file to version control.
#
# Production VanAssist (Aug 2026): Admin API, Ask and traveller facilities are
# enabled on the live site. New installs and this template default to off until
# deliberately enabled — see docs/PRODUCTION_CURRENT_STATE.md.
# =====================================================================

APP_NAME=VanAssist
APP_ENV=production
APP_DEBUG=false
APP_URL=https://vanassist.com.au
APP_KEY=
APP_RELEASE=

# Assist Platform brand resolution. Keep strict host checks off until every
# production/preview hostname is registered and tested.
ASSIST_DEFAULT_BRAND=vanassist
ASSIST_BRAND=
ASSIST_STRICT_BRAND_HOSTS=true
ASSIST_ALLOW_BRAND_QUERY=false

# Brand domains and deployment URLs
VANASSIST_DOMAIN=vanassist.com.au
VANASSIST_URL=https://vanassist.com.au
VANASSIST_LEGAL_NAME=VanAssist
VANASSIST_SUPPORT_EMAIL=
VANASSIST_ANALYTICS_ID=

TOWSMART_URL=https://towsmart.com.au
TOWSMART_DOMAIN=towsmart.com.au
TOWSMART_LEGAL_NAME=TowSmart
TOWSMART_SUPPORT_EMAIL=
TOWSMART_MAIL_FROM_ADDRESS=support@towsmart.com.au
TOWSMART_ANALYTICS_ID=

TRAILERWISE_URL=https://trailerwise.com.au
TRAILERWISE_DOMAIN=trailerwise.com.au
TRAILERWISE_LEGAL_NAME=TrailerWise
TRAILERWISE_SUPPORT_EMAIL=
TRAILERWISE_MAIL_FROM_ADDRESS=support@trailerwise.com.au
TRAILERWISE_ANALYTICS_ID=

# LocalTorque remains private until its production domain is purchased and
# explicitly configured. Do not point public DNS at localtorque.test.
LOCALTORQUE_URL=https://localtorque.test
LOCALTORQUE_DOMAIN=localtorque.test
LOCALTORQUE_LEGAL_NAME=LocalTorque
LOCALTORQUE_SUPPORT_EMAIL=
LOCALTORQUE_MAIL_FROM_ADDRESS=
LOCALTORQUE_ANALYTICS_ID=

# Polaris (private until production domain is confirmed)
POLARIS_STATUS=private
POLARIS_URL=https://polaris.test
POLARIS_DOMAIN=polaris.test
POLARIS_LEGAL_NAME=Polaris
POLARIS_SUPPORT_EMAIL=
POLARIS_MAIL_FROM_ADDRESS=
POLARIS_ANALYTICS_ID=

# Initial launch mode: private | provider-onboarding | local-pilot | public
LAUNCH_MODE=private

# Database (MySQL 8 / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Sessions
SESSION_LIFETIME=120
SESSION_SECURE=true
# Exact reverse-proxy IPs allowed to supply X-Forwarded-For/Proto, comma-separated.
TRUSTED_PROXIES=

# Mail (queued, processed by cron). Do NOT rely on PHP mail().
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=VanAssist

# Microsoft 365 Graph transport (set MAIL_DRIVER=graph). The certificate private
# key stays only on the server and must never be committed.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CERTIFICATE_PATH=storage/private/microsoft-graph-mail.crt
MICROSOFT_GRAPH_PRIVATE_KEY_PATH=storage/private/microsoft-graph-mail.key
MICROSOFT_GRAPH_PRIVATE_KEY_PASSWORD=
MICROSOFT_GRAPH_SENDING_MAILBOX=operations@vanassist.com.au
# Optional dedicated Exchange shared mailboxes. Leave blank until each mailbox
# exists, the Graph application is scoped to it, and external delivery passes.
MICROSOFT_GRAPH_VANASSIST_MAILBOX=
MICROSOFT_GRAPH_TOWSMART_MAILBOX=
MICROSOFT_GRAPH_TRAILERWISE_MAILBOX=
MICROSOFT_GRAPH_LOCALTORQUE_MAILBOX=
MAIL_MAX_ATTEMPTS=3

# Meta Graph API Page publishing (optional, review-first Social Studio action).
# Page tokens require the relevant Meta Page publishing permissions. Keep them
# only in the production secret store; never commit live tokens.
FACEBOOK_GRAPH_VERSION=v24.0
FACEBOOK_VANASSIST_PAGE_ID=
FACEBOOK_VANASSIST_PAGE_ACCESS_TOKEN=
FACEBOOK_TOWSMART_PAGE_ID=
FACEBOOK_TOWSMART_PAGE_ACCESS_TOKEN=
FACEBOOK_TRAILERWISE_PAGE_ID=
FACEBOOK_TRAILERWISE_PAGE_ACCESS_TOKEN=
FACEBOOK_LOCALTORQUE_PAGE_ID=
FACEBOOK_LOCALTORQUE_PAGE_ACCESS_TOKEN=

# Cloudflare Turnstile (optional bot protection)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Uploads / images
MAX_REQUEST_IMAGES=6
MAX_IMAGE_UPLOAD_MB=8
MAX_DOCUMENT_UPLOAD_MB=10
IMAGE_MAX_WIDTH=1800
IMAGE_MAX_DIMENSION=12000
IMAGE_MAX_PIXELS=24000000
THUMBNAIL_WIDTH=480

# Optional production road-distance routing. Keep this key server-side. The
# free Geoapify plan currently provides a limited daily commercial allowance.
GEOAPIFY_API_KEY=

# Feature flags
ENABLE_SMS=false
ENABLE_REVIEWS=false
ENABLE_PUBLIC_PHONE=false

# Billing / monetisation (all OFF for the free launch).
# The database tables and services exist, but nothing is charged or shown
# while these are false. Toggle on later without rebuilding provider data.
ENABLE_BILLING=false
ENABLE_PROVIDER_SUBSCRIPTIONS=false
ENABLE_PROVIDER_TRIALS=false
ENABLE_FEATURED_LISTINGS=false
ENABLE_FEATURED_RUNS=false
ENABLE_BOOKING_FEES=false
ENABLE_COMMISSIONS=false
ENABLE_CUSTOMER_PAYMENTS=false
ENABLE_PROVIDER_PAYOUTS=false
ENABLE_DISCOUNT_CODES=false
ENABLE_ANNUAL_BILLING=false

# Billing gateway: none | stripe  (use "none" while ENABLE_BILLING=false)
BILLING_GATEWAY=none
BILLING_CURRENCY=AUD
# Default free plan slug new providers fall back to (must exist in billing_plans).
BILLING_DEFAULT_FREE_PLAN=free_listing
# Days of access retained after a failed payment before paid features lock.
BILLING_GRACE_DAYS=14

# Stripe (only used when BILLING_GATEWAY=stripe). Never store raw card data.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Places (New) — discovery/gap-fill only. Never commit a real key.
# Used by tools/qld-places-gap-fill.js and Admin → Data Sources.
GOOGLE_PLACES_API_KEY=

# Google Routes API — server-side road distance and drive time. Use a separate,
# IP-restricted key with only Routes API enabled. Never commit a real key.
GOOGLE_ROUTES_API_KEY=
# Limits billable origin/destination elements per public search request.
GOOGLE_ROUTES_MAX_DESTINATIONS=40

# GST / Australian tax invoice defaults (review with an accountant before launch)
GST_REGISTERED=false
GST_RATE=10
BILLING_ABN=
BILLING_BUSINESS_NAME=VanAssist
GST_INCLUSIVE_PRICING=true
INVOICE_NUMBER_PREFIX=VA-

# Backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# Assist AI Orchestrator (Phase AI-3). Leave empty / disabled until owner-approved.
# Key is server-side only — never commit a real key; never store in MariaDB.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# FX used only for AUD budget estimates (not customer billing).
AI_USD_TO_AUD=1.6

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ADMIN_SESSION_TIMEOUT=30

# Versioned Admin API (/api/v1/admin) — CORE-011. Disabled until MFA-gated enablement.
# Assist RIC and other clients must never use production DB credentials.
ADMIN_API_ENABLED=false
# Production VanAssist enables Admin API for Assist RIC (Aug 2026). Keep false for new dev installs until rehearsed.
ADMIN_API_RESTRICTED=true
# Comma-separated user IDs allowed when restricted; empty = super-administrator only.
ADMIN_API_ALLOWED_USER_IDS=
ADMIN_API_MFA_REQUIRED=false
ADMIN_API_MFA_CHALLENGE_TTL=300
ADMIN_API_ACCESS_TOKEN_TTL=900
ADMIN_API_REFRESH_TOKEN_TTL=604800
ADMIN_API_SERVICE_TOKEN_TTL=3600
ADMIN_API_MAX_BATCH_SIZE=100
ADMIN_API_RECYCLE_RETENTION_DAYS=90

# Claim-first provider onboarding (VAN-010). Search-before-create on /for-providers/register.
CLAIM_FIRST_ONBOARDING=true
CLAIM_FIRST_DUPLICATE_THRESHOLD=70
