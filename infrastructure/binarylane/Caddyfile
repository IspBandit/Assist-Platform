{
	email admin@vanassist.com.au
	servers {
		protocols h1 h2 h3
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}
}

(assist_site) {
	import security_headers
	root * /var/www/html/public
	encode zstd gzip
	@serviceWorker path /service-worker.js
	header @serviceWorker Cache-Control "no-cache, no-store, must-revalidate"
	route {
		@unfinishedInstaller path /install /install/*
		respond @unfinishedInstaller "Installation is restricted to the server administrator." 403
		php_fastcgi app:9000 {
			env HTTP_HOST {http.request.host}
			env HTTPS on
		}
		file_server
	}
	log {
		output stdout
		format json
	}
}

(cqdiggings_site) {
	import security_headers
	root * /var/www/cqdiggings
	encode zstd gzip
	route {
		@private path /.git* /.htaccess /analytics/config.php /analytics/dashboard-config.php /analytics/config.example.php /analytics/dashboard-config.example.php /analytics/_stats/* /analytics/_contributions/* /analytics/_detector-settings/* /analytics/_detector-setting-uploads/* /analytics/_marketplace/* /analytics/_messages/*
		respond @private 404
		handle /data/community-contributions.json {
			root * /srv/cqdiggings-public
			file_server
		}
		handle /data/community-detector-settings.json {
			root * /srv/cqdiggings-public
			file_server
		}
		handle /data/marketplace-listings.json {
			root * /srv/cqdiggings-public
			file_server
		}
		handle /assets/community-detector-settings/* {
			root * /srv/cqdiggings-public
			file_server
		}
		handle /assets/marketplace/* {
			root * /srv/cqdiggings-public
			file_server
		}
		php_fastcgi cqdiggings:9000
		file_server
	}
	header /admin/* {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "no-store"
	}
	log {
		output stdout
		format json
	}
}

www.vanassist.com.au {
	redir https://vanassist.com.au{uri} permanent
}
vanassist.com.au {
	import assist_site
}
www.towsmart.com.au {
	redir https://towsmart.com.au{uri} permanent
}
towsmart.com.au {
	import assist_site
}
www.trailerwise.com.au {
	redir https://trailerwise.com.au{uri} permanent
}
trailerwise.com.au {
	import assist_site
}

www.cqdiggings.com.au {
	redir https://cqdiggings.com.au{uri} permanent
}
cqdiggings.com.au {
	import cqdiggings_site
}
