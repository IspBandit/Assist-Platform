# Environment / secrets
.env
*.key

# Deployment credentials (FTP) — copy scripts/deploy.env.example to scripts/deploy.env
/scripts/deploy.env

# Composer
/vendor/
/.vendor-local/
/.phpunit.cache/
/.phpstan.cache/

# Browser acceptance dependencies
/node_modules/

# Installation lock
/storage/installed.lock

# Runtime storage (keep folders via .gitkeep, ignore contents)
/storage/cache/*
/storage/logs/*
/storage/sessions/*
/storage/private/request-images/*
/storage/private/provider-documents/*
/storage/private/exports/*
/storage/backups/*
/storage/imports/*
!**/.gitkeep

# Public uploads
/public/uploads-public/*
!/public/uploads-public/.gitkeep

# Cron locks
/cron/*.lock

# Overpass/OSM import cache (raw API responses; regenerable)
/tools/.osm-cache/
/tools/.osm-stays-cache/
**/__pycache__/
*.py[cod]

# VanAssist traveller-data source archive: commit registry only; ignore large raw binaries
/data/sources/vanassist/**/*.csv
/data/sources/vanassist/**/*.geojson
/data/sources/vanassist/**/*.json
/data/sources/vanassist/**/*.zip
/data/sources/vanassist/**/*.shp
/data/sources/vanassist/**/*.dbf
/data/sources/vanassist/**/*.shx
/data/sources/vanassist/**/*.prj
/data/sources/vanassist/**/*.cpg
/data/sources/vanassist/**/*.pdf
/data/sources/vanassist/**/*.pbf
/data/sources/vanassist/**/*.xml
/data/sources/vanassist/**/*.html
/data/sources/vanassist/**/*.txt
/data/sources/vanassist/raw/
/data/sources/vanassist/normalized/
/data/sources/vanassist/reports/
!/data/sources/vanassist/registry/
!/data/sources/vanassist/registry/**
!/data/sources/vanassist/**/.gitkeep
!/data/sources/vanassist/README.md

# OS / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
